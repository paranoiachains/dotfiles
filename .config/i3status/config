general {
    output_format = i3bar
    interval = 5
    colors = true
}

order += "cpu_usage"
order += memory
order += "disk /"
order += "ethernet _first_"
order += "tztime local"


cpu_usage {
    format = "CPU: %usage"
}

memory {
    format = "Used: %used from %total"
}

disk "/" {
    format = "Disk: %free"
}

ethernet _first_ {
    format_up = "ETH: %ip"
    format_down = "ETH: down"
}

tztime local {
    format = "%H:%M %d-%m-%Y"
}
